<div class="w-50 mx-auto my-5">
    <h2 class="text-center">Create Employee</h2>

    <form action="/store" method="post">
        <div class="form-group my-2">
            <label for="empId" class="fw-bolder">Employee ID</label>
            <input type="text" class="form-control" id="empId" name="empId">
        </div>
        <div class="form-group my-2">
            <label for="name" class="fw-bolder">Name</label>
            <input type="text" class="form-control" id="name" name="name">
        </div>
        <div class="form-group my-2">
            <label for="address" class="fw-bolder">Address</label>
            <input type="text" class="form-control" id="address" name="address">
        </div>
        <div class="form-group my-2">
            <label for="salary" class="fw-bolder">Salary</label>
            <input type="number" class="form-control" id="salary" name="salary">
        </div>
        <div class="form-group my-2">
            <label for="gender" class="fw-bolder">Gender</label>
            <select class="form-control" name="gender" id="gender">
                <option value="Male">Male</option>
                <option value="Female">Female</option>
            </select>
        </div>
        <input type="submit" value="Add Employee" class="btn btn-dark mt-2">
    </form>
</div>
